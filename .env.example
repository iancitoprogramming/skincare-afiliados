# URL pública del sitio (para OpenGraph al compartir). En Vercel: tu dominio.
NEXT_PUBLIC_SITE_URL=

# Supabase (se usan a partir de la parte 2: catálogo y tracking)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. NUNCA exponer en el cliente ni con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Deploy ───────────────────────────────────────────────────────────────────
# Dominio propio, cuando lo tengas. Si no está, se usa el de Vercel solo.
# NEXT_PUBLIC_SITE_URL="https://clubdepiel.com"

# Código que da Pinterest para reclamar el dominio (Ajustes → Reclamar sitio).
# Se pega acá y sale como <meta name="p:domain_verify"> en el head.
# NEXT_PUBLIC_PINTEREST_VERIFY="abc123..."

# Id del Pinterest Tag (Ads → Conversiones → Pinterest Tag). Con él el sitio
# le avisa a Pinterest cada página vista, cada correo guardado y cada clic a
# Mercado Libre, y Pinterest los atribuye al pin. Es el único tercero con cookies
# del sitio, así que se prende a mano: sin la variable no se carga nada. Ver
# src/lib/pinterest.ts. Público, va como config en Vercel.
# NEXT_PUBLIC_PINTEREST_TAG_ID="2612345678901"

# ── API de Mercado Libre ─────────────────────────────────────────────────────
# De developers.mercadolibre.com.ar, al registrar la aplicación.
#
# El nombre de la app no puede llevar "mercado", "libre", "pago" ni "envíos":
# lo restringen los Términos de Desarrolladores. Soporte confirmó por escrito
# (6/9/2026) que esa restricción alcanza sólo al nombre y diseño de la app, no
# al sitio, así que el "Ver en Mercado Libre" se queda. Ver 07-AFILIADOS.md.
#
# Sin credenciales la API entera responde 401/403, incluso el listado de
# categorías. No hay forma de probar nada antes de registrar.
#
# NUNCA con prefijo NEXT_PUBLIC_: eso hornearía el secret en el JavaScript que
# recibe cada visitante. En Vercel va como variable Sensitive, al revés que
# NEXT_PUBLIC_SITE_URL y NEXT_PUBLIC_PINTEREST_VERIFY, que son públicas y van
# como config.
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# ── Resend: el mail que sale cuando alguien deja su correo ───────────────────
# Con RESEND_API_KEY ausente no pasa nada: el lead se guarda en Supabase igual y
# no sale ningún mail. En Vercel, la key va como variable Sensitive y sólo en los
# entornos que manden mails de verdad (Production; Preview si querés probar).
# Se crea en resend.com/api-keys con permiso "Sending access" y restringida al
# dominio clubdepiel.store, que ya está verificado en Resend.
RESEND_API_KEY=
RESEND_FROM="Club de Piel <hola@clubdepiel.store>"
# Segmento y topic del contacto en Resend. No son secretos: son referencias.
# Con el topic, el pie del mail lleva el link de baja que Resend genera.
RESEND_SEGMENT_ID=
RESEND_TOPIC_ID=
# Opcional: una casilla que recibe un aviso por cada correo nuevo.
NOTIFY_EMAIL=
