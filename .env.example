# URL pública del sitio (para OpenGraph al compartir). En Vercel: tu dominio.
NEXT_PUBLIC_SITE_URL=

# Supabase (se usan a partir de la parte 2: catálogo y tracking)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. NUNCA exponer en el cliente ni con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Deploy ───────────────────────────────────────────────────────────────────
# Dominio propio, cuando lo tengas. Si no está, se usa el de Vercel solo.
# NEXT_PUBLIC_SITE_URL="https://clubdepiel.com"

# Código que da Pinterest para reclamar el dominio (Ajustes → Reclamar sitio).
# Se pega acá y sale como <meta name="p:domain_verify"> en el head.
# NEXT_PUBLIC_PINTEREST_VERIFY="abc123..."

# ── API de Mercado Libre ─────────────────────────────────────────────────────
# De developers.mercadolibre.com.ar, al registrar la aplicación.
#
# El nombre de la app no puede llevar "mercado", "libre", "pago" ni "envíos":
# lo restringen los Términos de Desarrolladores. Soporte confirmó por escrito
# (6/9/2026) que esa restricción alcanza sólo al nombre y diseño de la app, no
# al sitio, así que el "Ver en Mercado Libre" se queda. Ver 07-AFILIADOS.md.
#
# Sin credenciales la API entera responde 401/403, incluso el listado de
# categorías. No hay forma de probar nada antes de registrar.
#
# NUNCA con prefijo NEXT_PUBLIC_: eso hornearía el secret en el JavaScript que
# recibe cada visitante. En Vercel va como variable Sensitive, al revés que
# NEXT_PUBLIC_SITE_URL y NEXT_PUBLIC_PINTEREST_VERIFY, que son públicas y van
# como config.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
